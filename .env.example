# ChaosButton configuration (copy to .env; never commit .env)
APP_NAME=ChaosButton
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=sqlite:///./chaosbutton.db

# Local AI through Ollama. Use the exact tag shown by `ollama list`.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=90

# Hard safety limits enforced by the backend
MAX_EXPERIMENT_DURATION=120
MAX_AFFECTED_REQUESTS=100
MAX_INJECTED_DELAY_MS=5000
MAX_CONCURRENCY=5
MAX_BASELINE_REQUESTS=50

# Targets: loopback is always allowed. Remote hosts must be listed here
# (comma separated) AND confirmed as owned by the user in the UI.
DEFAULT_TARGET_HOST=127.0.0.1
ALLOWED_REMOTE_HOSTS=

# Upstream used by the demo shop's dependency calls (inventory/payment)
UPSTREAM_URL=http://127.0.0.1:9100

CORS_ORIGINS=http://localhost:5173
